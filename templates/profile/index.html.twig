{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row">
        <!-- Carte de profil utilisateur -->
        <div class="col-md-4">
            <div class="card mb-4 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0">{{ user.username ?? user.email }}</h2>
                </div>
                <div class="card-body text-center">
                    {% if user.avatar %}
                        <img src="{{ user.avatar }}" alt="Avatar" class="img-fluid rounded-circle mb-3" style="max-width: 150px;">
                    {% else %}
                        <div class="bg-light rounded-circle mx-auto mb-3" style="width: 150px; height: 150px; display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-user fa-4x text-muted"></i>
                        </div>
                    {% endif %}
                    
                    <p class="text-muted mb-3">Membre depuis {{ user.userBooks[0] ? user.userBooks[0].addedAt|date('d/m/Y') : 'N/A' }}</p>
                    
       
                </div>
                <div class="card-footer">
                    <div class="row text-center">
                        <div class="col">
                            <h5>{{ ownedBooks|length }}</h5>
                            <small class="text-muted">Comics possédés</small>
                        </div>
                        <div class="col">
                            <h5>{{ wishlistBooks|length }}</h5>
                            <small class="text-muted">Souhaités</small>
                        </div>
                        <div class="col">
                            <h5>{{ favoriteBooks|length }}</h5>
                            <small class="text-muted">Favoris</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Carte de navigation -->
            <div class="card mb-4 shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">Navigation</h4>
                </div>
                <div class="list-group list-group-flush">
                    <a href="#favoris" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Mes favoris
                        <span class="badge bg-primary rounded-pill">{{ favoriteBooks|length }}</span>
                    </a>
                    <a href="#wishlist" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Ma liste de souhaits
                        <span class="badge bg-primary rounded-pill">{{ wishlistBooks|length }}</span>
                    </a>
                    <a href="#collection" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        Ma collection
                        <span class="badge bg-primary rounded-pill">{{ ownedBooks|length }}</span>
                    </a>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <!-- Comics préférés -->
            <div class="card mb-4 shadow-sm" id="favoris">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Mes comics préférés</h3>
                    <span class="badge bg-light text-primary">{{ favoriteBooks|length }}</span>
                </div>
                <div class="card-body">
                    {% if favoriteBooks|length > 0 %}
                        <div class="row">
                            {% for book in favoriteBooks %}
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 shadow-sm">
                                        {% if book.image %}
                                            <img src="/uploads/images/{{ book.image }}" class="card-img-top" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-5">
                                                <i class="fas fa-book fa-2x text-muted"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title text-truncate" title="{{ book.title }}">{{ book.title }}</h5>
                                            {% if book.subtitle %}
                                                <h6 class="card-subtitle mb-2 text-muted text-truncate" title="{{ book.subtitle }}">{{ book.subtitle }}</h6>
                                            {% endif %}
                                            
                                            <!-- Afficher la notation -->
                                            <div class="my-2">
                                                {% set userBook = book.userBooks.filter(ub => ub.user.id == user.id).first %}
                                                {% if userBook and userBook.rating %}
                                                    <div class="text-warning">
                                                        {% for i in 1..5 %}
                                                            {% if i <= userBook.rating %}
                                                                <i class="fas fa-star"></i>
                                                            {% else %}
                                                                <i class="far fa-star"></i>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                            
                                            <div class="d-grid gap-2">
                                                <a href="{{ path('app_book_show', {'id': book.id, 'slug': book.title|slug}) }}" class="btn btn-sm btn-primary">Voir</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Vous n'avez pas encore de comics favoris
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Liste de souhaits -->
            <div class="card mb-4 shadow-sm" id="wishlist">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Ma liste de souhaits</h3>
                    <span class="badge bg-light text-primary">{{ wishlistBooks|length }}</span>
                </div>
                <div class="card-body">
                    {% if wishlistBooks|length > 0 %}
                        <div class="row">
                            {% for book in wishlistBooks %}
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 shadow-sm">
                                        {% if book.image %}
                                            <img src="/uploads/images/{{ book.image }}" class="card-img-top" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-5">
                                                <i class="fas fa-book fa-2x text-muted"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title text-truncate" title="{{ book.title }}">{{ book.title }}</h5>
                                            {% if book.subtitle %}
                                                <h6 class="card-subtitle mb-2 text-muted text-truncate" title="{{ book.subtitle }}">{{ book.subtitle }}</h6>
                                            {% endif %}
                                            
                                            <div class="d-flex justify-content-between mt-3">
                                                <a href="{{ path('app_book_show', {'id': book.id, 'slug': book.title|slug}) }}" class="btn btn-sm btn-primary">Voir</a>
                                                <a href="{{ path('app_profile_add_book', {'id': book.id, 'action': 'own'}) }}" class="btn btn-sm btn-success" title="Marquer comme possédé">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Votre liste de souhaits est vide
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Ma collection -->
            <div class="card mb-4 shadow-sm" id="collection">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Ma collection</h3>
                    <span class="badge bg-light text-primary">{{ ownedBooks|length }}</span>
                </div>
                <div class="card-body">
                    {% if ownedBooks|length > 0 %}
                        <div class="row">
                            {% for book in ownedBooks %}
                                <div class="col-md-4 mb-3">
                                    <div class="card h-100 shadow-sm">
                                        {% if book.image %}
                                            <img src="/uploads/images/{{ book.image }}" class="card-img-top" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-5">
                                                <i class="fas fa-book fa-2x text-muted"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title text-truncate" title="{{ book.title }}">{{ book.title }}</h5>
                                            {% if book.subtitle %}
                                                <h6 class="card-subtitle mb-2 text-muted text-truncate" title="{{ book.subtitle }}">{{ book.subtitle }}</h6>
                                            {% endif %}
                                            
                                            <!-- Status -->
                                            {% set userBook = book.userBooks.filter(ub => ub.user.id == user.id).first %}
                                            {% if userBook %}
                                                <div class="mb-2">
                                                    {% if userBook.isRead %}
                                                        <span class="badge bg-success">Lu</span>
                                                    {% else %}
                                                        <span class="badge bg-secondary">Non lu</span>
                                                    {% endif %}
                                                    
                                                    {% if userBook.rating %}
                                                        <span class="badge bg-warning text-dark">
                                                            {{ userBook.rating }}<i class="fas fa-star ms-1"></i>
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                            
                                            <div class="d-flex justify-content-between mt-3">
                                                <a href="{{ path('app_book_show', {'id': book.id, 'slug': book.title|slug}) }}" class="btn btn-sm btn-primary">Voir</a>
                                                <a href="{{ path('app_profile_add_book', {'id': book.id, 'action': 'read'}) }}" class="btn btn-sm btn-outline-primary" title="Marquer comme lu">
                                                    <i class="fas fa-book-reader"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            Vous n'avez pas encore de comics dans votre collection
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}