{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container">
    <div class="row">
        <!-- Informations utilisateur -->
        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h2>{{ user.username ?? user.email }}</h2>
                </div>
                <div class="card-body">
                    <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">Modifier mon profil</a>
                </div>
                <div class="card-footer">
                    <div class="row">
                        <div class="col">Possédés: {{ ownedBooks|length }}</div>
                        <div class="col">Souhaités: {{ wishlistBooks|length }}</div>
                        <div class="col">Lus: {{ readBooks|length }}</div>
                    </div>
                </div>
            </div>
            
            <!-- Navigation -->
            <div class="card">
                <div class="card-header">
                    <h4>Navigation</h4>
                </div>
                <div class="list-group list-group-flush">
                    <a href="#favoris" class="list-group-item">Mes favoris</a>
                    <a href="#wishlist" class="list-group-item">Ma liste de souhaits</a>
                    <a href="#collection" class="list-group-item">Ma collection</a>
                </div>
            </div>
        </div>
        
        <div class="col-md-8">
            <!-- Favoris -->
            <div class="card mb-3" id="favoris">
                <div class="card-header">
                    <h3>Mes comics préférés</h3>
                </div>
                <div class="card-body">
                    {% set hasFavorites = false %}
                    <div class="row">
                        {% for userBook in userBooks|default([]) %}
                            {% if userBook.rating is defined and userBook.rating == 5 %}
                                {% set hasFavorites = true %}
                                <div class="col-md-2 mb-3">
                                    <div class="card h-100">
                                        {% if userBook.book.image %}
                                            <img src="/uploads/images/{{ userBook.book.image }}" class="card-img-top" alt="{{ userBook.book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-4">
                                                <i class="fas fa-book fa-2x"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title">{{ userBook.book.title }}</h5>
                                            <p class="card-subtitle">{{ userBook.book.subtitle }}</p>
                                            <span class="badge bg-success">
                                                <i class="fas fa-thumbs-up"></i> J'aime
                                            </span>
                                        </div>
                                        <div class="card-footer">
                                            <a href="{{ path('app_book_show', {'id': userBook.book.id, 'slug': userBook.book.title|slug}) }}" class="btn btn-primary btn-sm w-100 mb-1">Voir</a>
                                            <a href="{{ path('app_profile_book_rate', {'id': userBook.book.id, 'rating': 3}) }}" class="btn btn-warning btn-sm w-100">Retirer</a>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                    
                    {% if not hasFavorites %}
                        <div class="alert alert-info">Vous n'avez pas encore de comics favoris</div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Liste de souhaits -->
            <div class="card mb-3" id="wishlist">
                <div class="card-header">
                    <h3>Ma liste de souhaits</h3>
                </div>
                <div class="card-body">
                    {% if wishlistBooks|length > 0 %}
                        <div class="row">
                            {% for book in wishlistBooks %}
                               <div class="col-md-2 mb-3">
                                    <div class="card h-100">
                                        {% if book.image %}
                                            <img src="/uploads/images/{{ book.image }}" class="card-img-top" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-4">
                                                <i class="fas fa-book fa-2x"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body">
                                            <h5 class="card-title">{{ book.title }}</h5>
                                            <h3 class="card-title">{{ book.subtitle }}</h3>

                                            
                                            <!-- Avis actuel si existant -->
                                            {% set currentRating = null %}
                                            {% for userBook in userBooks|default([]) %}
                                                {% if userBook.book.id == book.id and userBook.rating is defined %}
                                                    {% set currentRating = userBook.rating %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if currentRating is not null %}
                                                <div class="mb-2">
                                                    {% if currentRating == 5 %}
                                                        <span class="badge bg-success"><i class="fas fa-thumbs-up"></i> J'aime</span>
                                                    {% elseif currentRating == 1 %}
                                                        <span class="badge bg-danger"><i class="fas fa-thumbs-down"></i> Je n'aime pas</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        </div>
                                        <div class="card-footer">
                                            <a href="{{ path('app_book_show', {'id': book.id, 'slug': book.title|slug}) }}" class="btn btn-primary btn-sm w-100 mb-1">Voir</a>
                                            
                                            <div class="row g-1 mb-1">
                                                <div class="col-6">
                                                    <a href="{{ path('app_profile_book_own', {'id': book.id}) }}" class="btn btn-success btn-sm w-100">Posséder</a>
                                                </div>
                                                <div class="col-6">
                                                    <a href="{{ path('app_profile_book_unwishlist', {'id': book.id}) }}" class="btn btn-danger btn-sm w-100">Retirer</a>
                                                </div>
                                            </div>
                                            
                                            <div class="row g-1">
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 5}) }}" class="btn btn-sm w-100 {% if currentRating == 5 %}btn-success{% else %}btn-outline-success{% endif %}">
                                                        <i class="fas fa-thumbs-up"></i>
                                                    </a>
                                                </div>
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 3}) }}" class="btn btn-sm w-100 btn-outline-secondary">
                                                        <i class="fas fa-minus"></i>
                                                    </a>
                                                </div>
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 1}) }}" class="btn btn-sm w-100 {% if currentRating == 1 %}btn-danger{% else %}btn-outline-danger{% endif %}">
                                                        <i class="fas fa-thumbs-down"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Votre liste de souhaits est vide</div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Collection -->
            <div class="card mb-3" id="collection">
                <div class="card-header">
                    <h3>Ma collection</h3>
                </div>
                <div class="card-body">
                    {% if ownedBooks|length > 0 %}
                        <div class="row">
                            {% for book in ownedBooks %}
                                <div class="col-md-2 mb-3">
                                    <div class="card h-100">
                                        {% if book.image %}
                                            <img src="/uploads/images/{{ book.image }}" class="card-img-top" alt="{{ book.title }}">
                                        {% else %}
                                            <div class="bg-light text-center p-3">
                                                <i class="fas fa-book"></i>
                                            </div>
                                        {% endif %}
                                        <div class="card-body p-2">
                                            <h6 class="card-title fs-6">{{ book.title }}</h6>

                                            
                                            <!-- Status et avis depuis userBooks -->
                                            {% set currentRating = null %}
                                            {% set isRead = false %}
                                            {% for userBook in userBooks|default([]) %}
                                                {% if userBook.book.id == book.id %}
                                                    {% if userBook.rating is defined %}
                                                        {% set currentRating = userBook.rating %}
                                                    {% endif %}
                                                    {% if userBook.isRead %}
                                                        {% set isRead = true %}
                                                    {% endif %}
                                                {% endif %}
                                            {% endfor %}
                                            
                                            <div class="mb-2">
                                                <span class="badge {% if isRead %}bg-success{% else %}bg-secondary{% endif %} small">
                                                    {% if isRead %}Lu{% else %}Non lu{% endif %}
                                                </span>
                                                
                                                {% if currentRating == 5 %}
                                                    <span class="badge bg-success small">
                                                        <i class="fas fa-thumbs-up"></i>
                                                    </span>
                                                {% elseif currentRating == 1 %}
                                                    <span class="badge bg-danger small">
                                                        <i class="fas fa-thumbs-down"></i>
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="card-footer p-1">
                                            <a href="{{ path('app_book_show', {'id': book.id, 'slug': book.title|slug}) }}" class="btn btn-primary btn-sm w-100 mb-1">Voir</a>
                                            
                                            {% if isRead %}
                                                <a href="{{ path('app_profile_book_unread', {'id': book.id}) }}" class="btn btn-secondary btn-sm w-100 mb-1">Non lu</a>
                                            {% else %}
                                                <a href="{{ path('app_profile_book_read', {'id': book.id}) }}" class="btn btn-success btn-sm w-100 mb-1">Lu</a>
                                            {% endif %}
                                            
                                            <div class="row g-1 mb-1">
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 5}) }}" class="btn btn-sm w-100 p-1 {% if currentRating == 5 %}btn-success{% else %}btn-outline-success{% endif %}">
                                                        <i class="fas fa-thumbs-up"></i>
                                                    </a>
                                                </div>
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 3}) }}" class="btn btn-sm w-100 p-1 btn-outline-secondary">
                                                        <i class="fas fa-minus"></i>
                                                    </a>
                                                </div>
                                                <div class="col-4">
                                                    <a href="{{ path('app_profile_book_rate', {'id': book.id, 'rating': 1}) }}" class="btn btn-sm w-100 p-1 {% if currentRating == 1 %}btn-danger{% else %}btn-outline-danger{% endif %}">
                                                        <i class="fas fa-thumbs-down"></i>
                                                    </a>
                                                </div>
                                            </div>
                                            
                                            <a href="{{ path('app_profile_book_unown', {'id': book.id}) }}" class="btn btn-danger btn-sm w-100">Retirer</a>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-info">Vous n'avez pas encore de comics dans votre collection</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}