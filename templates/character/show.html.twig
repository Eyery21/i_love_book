{% extends 'base.html.twig' %}

{% block title %}{{ character.name }}{% endblock %}

{% block body %}
	<div class="character-background text-white" style="background-image: url('/uploads/character_images/{{ character.getBackgroundPage() }}');
	width: 100%;
	min-height: 100vh;
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
	padding: 20px;">
		<div class="container">
			<h1 class="mb-4 text-center">{{ character.name }}</h1>

			{% if variants|length > 0 %}
                <div class="mb-4">
                    <!-- Navigation avec liens directs vers les pages des variantes -->
                    <div class="character-variants bg-white p-2 rounded">
                        <span class="me-2">Incarnations:</span>
                        <a href="{{ path('app_character_show', {'id': character.id}) }}" class="btn btn-sm {% if app.request.get('id') == character.id %}btn-primary{% else %}btn-outline-primary{% endif %} me-1">
                            {% if character.realName %}{{ character.realName }}{% else %}{{ character.name }}{% endif %}
                        </a>
                        {% for variant in variants %}
                            <a href="{{ path('app_character_show', {'id': variant.id}) }}" class="btn btn-sm {% if app.request.get('id') == variant.id %}btn-primary{% else %}btn-outline-primary{% endif %} me-1">
                                {% if variant.realName %}{{ variant.realName }}{% else %}{{ variant.name }}{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <!-- Détails du personnage courant -->
            <table class="table table-bordered bg-light text-dark">
                <tbody>
                    <tr>
                        <th scope="row">Name</th>
                        <td>{{ character.name }}</td>
                    </tr>
                    {% if character.realName %}
                    <tr>
                        <th scope="row">Real Name</th>
                        <td>{{ character.realName }}</td>
                    </tr>
                    {% endif %}
                    {% if character.alias %}
                    <tr>
                        <th scope="row">Alias</th>
                        <td>{{ character.alias }}</td>
                    </tr>
                    {% endif %}
                    {% if character.alignment %}
                    <tr>
                        <th scope="row">Alignment</th>
                        <td>{{ character.alignment }}</td>
                    </tr>
                    {% endif %}
                    {% if character.espece %}
                    <tr>
                        <th scope="row">Species</th>
                        <td>{{ character.espece }}</td>
                    </tr>
                    {% endif %}
                    {% if character.baseOfOperations %}
                    <tr>
                        <th scope="row">Base of Operations</th>
                        <td>{{ character.baseOfOperations }}</td>
                    </tr>
                    {% endif %}
                    {% if character.nemesys %}
                    <tr>
                        <th scope="row">Nemesis</th>
                        <td>{{ character.nemesys }}</td>
                    </tr>
                    {% endif %}
                    {% if character.occupation %}
                    <tr>
                        <th scope="row">Occupation</th>
                        <td>{{ character.occupation }}</td>
                    </tr>
                    {% endif %}
                    {% if character.affiliations %}
                    <tr>
                        <th scope="row">Affiliations</th>
                        <td>
                            {% if character.affiliations is iterable %}
                                <ul class="list-unstyled mb-0">
                                    {% for affiliation in character.affiliations %}
                                        <li>{{ affiliation }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                {{ character.affiliations }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
                    {% if character.originStory %}
                    <tr>
                        <th scope="row">Origin Story</th>
                        <td>{{ character.originStory|nl2br }}</td>
                    </tr>
                    {% endif %}
                    {% if character.power %}
                    <tr>
                        <th scope="row">Powers</th>
                        <td>
                            {% if character.power is iterable %}
                                <ul class="list-unstyled mb-0">
                                    {% for power in character.power %}
                                        <li>{{ power }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                {{ character.power }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
                    {% if character.equipement %}
                    <tr>
                        <th scope="row">Equipment</th>
                        <td>
                            {% if character.equipement is iterable %}
                                <ul class="list-unstyled mb-0">
                                    {% for item in character.equipement %}
                                        <li>{{ item }}</li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                {{ character.equipement }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>

			<h3 class="mt-5">Appearances</h3>
			<h4 style="color: #3498db; border-bottom: 2px solid #3498db; padding-bottom: 10px; margin-bottom: 20px;">Séries</h4>

			<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
				{% set seriesFound = false %}
				{% for serie in series %}
					{% if serie.length > 1 %}
						{% set seriesFound = true %}
						<div class="col">
							<div class="card h-100 shadow">
								{% if serie.image %}
									<img src="/uploads/series_images/{{ serie.image }}" class="card-img-top" alt="{{ serie.title }}" style="height: 220px; object-fit: cover;">
								{% else %}
									<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
										<span class="text-muted fst-italic">Pas d'image</span>
									</div>
								{% endif %}
								<div class="card-body d-flex flex-column">
									<h5 class="card-title">{{ serie.title }}</h5>
									<p class="card-text text-muted">Série en {{ serie.length }} tomes</p>
									<a href="{{ path('app_series_show', {'id': serie.id}) }}" class="btn btn-primary mt-auto">Voir la série</a>
								</div>
							</div>
						</div>
					{% endif %}
				{% endfor %}
				
				{% if not seriesFound %}
					<div class="col-12 text-center text-white fst-italic">
						<p>Aucune série trouvée.</p>
					</div>
				{% endif %}
			</div>

			<h4 class="mt-5" style="color: #3498db; border-bottom: 2px solid #3498db; padding-bottom: 10px; margin-bottom: 20px;">One-Shots</h4>
			
			<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
				{% set oneShots = false %}
				{% for serie in series %}
					{% if serie.length == 1 %}
						{% set oneShots = true %}
						<div class="col">
							<div class="card h-100 shadow">
								{% if serie.image %}
									<img src="/uploads/series_images/{{ serie.image }}" class="card-img-top" alt="{{ serie.title }}" style="height: 220px; object-fit: cover;">
								{% else %}
									<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
										<span class="text-muted fst-italic">Pas d'image</span>
									</div>
								{% endif %}
								<div class="card-body d-flex flex-column">
									<h5 class="card-title">{{ serie.title }}</h5>
									<p class="card-text text-muted">Récit complet</p>
									<a href="{{ path('app_series_show', {'id': serie.id}) }}" class="btn btn-primary mt-auto">Voir le comics</a>
								</div>
							</div>
						</div>
					{% endif %}
				{% endfor %}
				
				{% if not oneShots %}
					<div class="col-12 text-center text-white fst-italic">
						<p>Aucun one-shot trouvé.</p>
					</div>
				{% endif %}
			</div>

			<div class="mt-4 text-center">
				<a href="{{ path('app_character_index') }}" class="btn btn-primary">Back to List</a>
				<a href="{{ path('app_character_edit', {'id': character.id}) }}" class="btn btn-secondary">Edit</a>
				{{ include('character/_delete_form.html.twig') }}
			</div>
		</div>
	</div>
{% endblock %}