{% extends 'base.html.twig' %}

{% block title %}Modifier {{ character.name }}{% endblock %}

{% block body %}
<div class="character-edit-background" style="
    background-image: linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)), 
                      url('/uploads/character_images/{{ character.getBackgroundPage() }}');
    background-size: cover;
    background-position: center;
    min-height: 100vh;
    padding: 40px 0;
">
    <div class="container">
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h1 class="mb-0"><i class="fas fa-edit me-2"></i>Modifier {{ character.name }}</h1>
                {% if character.realName %}
                <span class="badge bg-secondary">{{ character.realName }}</span>
                {% endif %}
            </div>
            
            <div class="card-body">
                {{ include('character/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
            </div>
            
            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('app_character_show', {'id': character.id}) }}" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Retour à la fiche du personnage
                </a>
                <a href="{{ path('app_character_index') }}" class="btn btn-info">
                    <i class="fas fa-list me-1"></i> Retour à la liste
                </a>
                <div>
                    {{ include('character/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
        
        {% if variants|default([])|length > 0 %}
        <div class="card mt-4 shadow">
            <div class="card-header bg-info text-white">
                <h2 class="h5 mb-0">Autres incarnations de {{ character.name }}</h2>
            </div>
            <div class="card-body">
                <div class="row">
                    {% for variant in variants %}
                    <div class="col-md-4 mb-3">
                        <div class="card h-100">
                            <div class="card-body">
                                <h3 class="h5">{{ variant.realName }}</h3>
                                <p class="small text-muted">{{ variant.name }}</p>
                            </div>
                            <div class="card-footer">
                                <a href="{{ path('app_character_edit', {'id': variant.id}) }}" class="btn btn-sm btn-outline-primary">
                                    Modifier
                                </a>
                                <a href="{{ path('app_character_show', {'id': variant.id}) }}" class="btn btn-sm btn-outline-secondary">
                                    Voir
                                </a>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% block stylesheets %}
<style>
    /* Ajustements pour l'apparence du formulaire */
    .form-group {
        margin-bottom: 1.5rem;
    }
    
    .form-group label {
        font-weight: bold;
        margin-bottom: 0.5rem;
    }
    
    /* Animation sur le bouton delete */
    .btn-danger {
        transition: all 0.3s ease;
    }
    
    .btn-danger:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
    }
    
    /* Stylisation pour la carte principale */
    .card {
        border: none;
        border-radius: 10px;
        overflow: hidden;
    }
    
    .card-header {
        padding: 1.25rem;
    }
    
    /* Stylisation pour les inputs */
    .form-control:focus {
        border-color: #3498db;
        box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
    }
</style>
{% endblock %}

{% endblock %}