 <div class="series-continuity"style="margin: 30px 0;border:1px solid black; padding: 25px; background-color: white; border-radius: 8px; box-shadow: 0 2px 15px rgba(0,0,0,0.08);">
    <h3 style="color: #3498db; margin: 0 0 20px 0; padding-bottom: 12px; border-bottom: 2px solid #3498db; font-weight: 600; font-size: 1.2rem;">Continuité de l'histoire</h3>
    
    {% if series %}
    
        
       <div class="series-timeline" style="display: flex; gap: 20px; margin: 30px 0;">
    <!-- Section série précédente -->
    {% if previousSeries %}
        <div class="timeline-item" style="display: flex; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background-color: #3498db; color: white; display: flex; justify-content: center; align-items: center; margin-right: 15px; margin-top: 15px;">
                <span style="font-size: 1rem;">←</span>
            </div>
            <div style="flex-grow: 1;">
                <p style="margin: 0 0 10px 0; font-size: 0.9rem; color: #7f8c8d; padding: 10px 0;">Série précédente</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px;">
                    <a href="{{ path('app_series_show', {'id': previousSeries.id}) }}" style="text-decoration: none; color: inherit; display: block; background-color: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: transform 0.2s, box-shadow 0.2s;">
                        <div style="height: 100px; overflow: hidden;">
                            {% if previousSeries.image %}
                                <img src="/uploads/series_images/{{ previousSeries.image }}" alt="{{ previousSeries.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                            {% else %}
                                <div style="width: 100%; height: 100%; background-color: #e0e0e0; display: flex; justify-content: center; align-items: center;">
                                    <span style="color: #777; font-size: 0.8rem;">Pas d'image</span>
                                </div>
                            {% endif %}
                        </div>
                        <div style="padding: 10px;">
                            <h5 style="margin: 0 0 5px 0; font-size: 0.95rem; color: #2c3e50; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ previousSeries.title }}</h5>
                            <p style="margin: 0; font-size: 0.8rem; color: #7f8c8d;">{{ previousSeries.books|length }} livre(s)</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
    
        <div class="current-series" style="width:300px; margin-bottom: 25px;border:1px solid black; padding: 15px; background-color: #f8f9fa; border-radius: 8px; display: flex; align-items: center;">
            <div style="flex-shrink: 0; width: 80px; height: 80px; margin-right: 15px; border-radius: 6px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                {% if series.image %}
                    <img src="/uploads/series_images/{{ series.image }}" alt="{{ series.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                    <div style="width: 100%; height: 100%; background-color: #e0e0e0; display: flex; justify-content: center; align-items: center;">
                        <span style="color: #777; font-size: 0.8rem;">No image</span>
                    </div>
                {% endif %}
            </div>
            <div>
                <p style="margin: 0 0 5px 0; font-size: 0.9rem; color: #7f8c8d;">Série actuelle</p>
                <h4 style="margin: 0; font-size: 1.1rem; color: #2c3e50;">{{ series.title }}</h4>
            </div>
        </div>

    <!-- Section séries suivantes -->
    {% if nextSeries|length > 0 %}
        <div class="timeline-item" style="display: flex; align-items: flex-start;">
            <div style="flex-shrink: 0; width: 30px; height: 30px; border-radius: 50%; background-color: #3498db; color: white; display: flex; justify-content: center; align-items: center; margin-right: 15px; margin-top: 15px;">
                <span style="font-size: 1rem;">→</span>
            </div>
            <div style="flex-grow: 1;">
                <p style="margin: 0 0 10px 0; font-size: 0.9rem; color: #7f8c8d; padding: 10px 0;">Séries suivantes</p>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 15px;">
                    {% for nextSerie in nextSeries %}
                        <a href="{{ path('app_series_show', {'id': nextSerie.id}) }}" style="text-decoration: none; color: inherit; display: block; background-color: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); transition: transform 0.2s, box-shadow 0.2s;">
                            <div style="height: 100px; overflow: hidden;">
                                {% if nextSerie.image %}
                                    <img src="/uploads/series_images/{{ nextSerie.image }}" alt="{{ nextSerie.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                                {% else %}
                                    <div style="width: 100%; height: 100%; background-color: #e0e0e0; display: flex; justify-content: center; align-items: center;">
                                        <span style="color: #777; font-size: 0.8rem;">Pas d'image</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div style="padding: 10px;">
                                <h5 style="margin: 0 0 5px 0; font-size: 0.95rem; color: #2c3e50; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{{ nextSerie.title }}</h5>
                                <p style="margin: 0; font-size: 0.8rem; color: #7f8c8d;">{{ nextSerie.books|length }} livre(s)</p>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% endif %}
</div>
    {% else %}
        <div style="padding: 20px; background-color: #f8f9fa; border-radius: 8px; text-align: center; color: #7f8c8d;">
            <p style="margin: 0;">Ce livre n'appartient à aucune série.</p>
        </div>
    {% endif %}
</div>
</div>