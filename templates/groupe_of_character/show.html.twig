{% extends 'base.html.twig' %}


{% block body %}
    <h1>{{ groupe_of_character.name }}</h1>

    <table class="table">
        <tbody>
          
            <tr>
                <th>Name</th>
                <td>{{ groupe_of_character.name }}</td>
            </tr>
    
            <tr>
                <th>membres notables</th>
                <td>{{ groupe_of_character.description }}</td>
            </tr>
      
            <tr>
                <th>Image</th>
                {% if groupe_of_character.image %}
                <img src="/uploads/group_images/{{ groupe_of_character.image }}" alt="Image du livre" style="min-width: 1200px;">
            {% else %}
                <em>Pas d'image</em>
            {% endif %}           
         </tr>
           
            <tr>
                <th>Headquarters</th>
                <td>{{ groupe_of_character.headquarters }}</td>
            </tr>
          
        </tbody>
    </table>

    <a href="{{ path('app_groupe_of_character_index') }}">back to list</a>

      {% if is_granted('ROLE_ADMIN') %}

                        <a href="{{ path('app_groupe_of_character_edit', {'id': groupe_of_character.id}) }}">edit</a>
                        {{ include('groupe_of_character/_delete_form.html.twig') }}
                    {% endif %}

{% endblock %}
