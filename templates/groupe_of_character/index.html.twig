{% extends 'base.html.twig' %}

{% block title %}GroupeOfCharacter index{% endblock %}

{% block body %}
    <h1>GroupeOfCharacter index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
             

            </tr>
        </thead>
        <tbody>
        {% for groupe_of_character in groupe_of_characters %}
            <tr>
                <td>{{ groupe_of_character.name }}</td>
                
                <td>     <div class="book-image" style="margin-left: 20px;">
                    {% if groupe_of_character.image %}
                        <img src="/uploads/group_images/{{ groupe_of_character.image }}" alt="Image du livre" style="max-width: 150px;">
                    {% else %}
                        <em>Pas d'image</em>
                    {% endif %}
                </div></td>              
                <td>
                    <a href="{{ path('app_groupe_of_character_show', {'id': groupe_of_character.id}) }}">show</a>

                    {% if is_granted('ROLE_ADMIN') %}

                        <a href="{{ path('app_groupe_of_character_edit', {'id': groupe_of_character.id}) }}">edit</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="10">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_groupe_of_character_new') }}">Create new</a>
{% endblock %}
